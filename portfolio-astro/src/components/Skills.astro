const defaultIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`;
---

<section id="skills" aria-label="Skills and technologies">
  <div class="container">
    <p class="section-label">Technical Skills</p>
    <h2>What I Work With</h2>

    <div class="skills-grid">
      {site.skills.map((s, i) => (
        <div
          class="skill-card card-glass"
          style={`animation-delay: ${i * 80}ms`}
        >
          <div class="skill-icon" set:html={icons[s.name] ?? defaultIcon} />
          <div class="skill-info">
            <h3>{s.name}</h3>
            <ul class="skill-items" aria-label={`${s.name} tools`}>
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  h2 {
    margin-bottom: 3rem;
  }

  .skills-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .skill-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  /* Icon */
  .skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    min-width: 3rem;
    border-radius: var(--radius);
    background: var(--accent-glow);
    border: 1px solid var(--line-hover);
    color: var(--accent);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .skill-card:hover .skill-icon {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  /* Info */
  .skill-info h3 {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
  }

  .skill-items li {
    font-size: var(--fs-xs);
    color: var(--muted);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.6rem;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .skill-card:hover .skill-items li {
    color: var(--ink-2);
    border-color: var(--line-hover);
  }
</style>

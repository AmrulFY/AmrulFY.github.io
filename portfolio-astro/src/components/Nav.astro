---
import { site } from '../data/site';
---

<header class="bar" id="site-header">
  <div class="container row">
    <!-- Logo / Brand -->
    <a class="brand" href="#top" aria-label="Back to top">
      <span class="brand-initials">AF</span>
      <span class="brand-name">{site.name.split(' ')[0]}</span>
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Primary navigation">
      <ul id="primary-nav" role="list">
        {site.nav.map((n) => (
          <li>
            <a href={n.href} class="nav-link">
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Actions: Theme toggle + Mobile menu -->
    <div class="actions">
      <!-- Dark/Light Toggle -->
      <button
        id="theme-toggle"
        class="icon-btn"
        aria-label="Toggle dark / light mode"
        title="Toggle theme"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          class="icon icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          class="icon icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <!-- Mobile hamburger -->
      <button
        class="toggle icon-btn"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Open navigation menu"
      >
        <svg
          class="icon icon-menu"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg
          class="icon icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* ---- Bar / Header ---- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    background: var(--nav-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
    transition:
      background var(--dur-slow) var(--ease),
      border-color var(--dur-slow) var(--ease);
  }

  .bar.scrolled {
    box-shadow: 0 2px 24px rgba(0, 0, 0, 0.18);
  }

  /* ---- Row layout ---- */
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1.5rem;
  }

  /* ---- Brand ---- */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }

  .brand-initials {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }

  .brand-name {
    font-weight: 700;
    font-size: var(--fs-sm);
    transition: color var(--dur) var(--ease);
  }

  .brand:hover .brand-name {
    color: var(--accent);
  }

  /* ---- Desktop nav ---- */
  nav {
    display: flex;
    align-items: center;
  }

  ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
    background: var(--accent-glow);
  }

  /* ---- Action buttons ---- */
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .icon-btn:hover {
    background: var(--accent-glow);
    color: var(--accent);
    border-color: var(--line-hover);
  }

  /* Theme toggle icon visibility */
  [data-theme='dark'] .icon-moon {
    display: none;
  }
  [data-theme='dark'] .icon-sun {
    display: block;
  }
  [data-theme='light'] .icon-sun {
    display: none;
  }
  [data-theme='light'] .icon-moon {
    display: block;
  }

  /* Mobile hamburger: hide close by default */
  .icon-close {
    display: none;
  }
  .toggle[aria-expanded='true'] .icon-menu {
    display: none;
  }
  .toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  /* Mobile: hide menu button on desktop */
  @media (min-width: 48rem) {
    .toggle {
      display: none;
    }
  }

  /* ---- Mobile nav ---- */
  @media (max-width: 47.99rem) {
    nav {
      position: fixed;
      inset: var(--nav-h) 0 auto 0;
      background: var(--nav-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line);
      overflow: hidden;
      max-height: 0;
      transition: max-height 300ms var(--ease);
    }

    nav[data-open] {
      max-height: 20rem;
    }

    ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.25rem 1.25rem;
    }

    .nav-link {
      padding: 0.8rem 0.5rem;
      border-radius: 0;
      border-bottom: 1px solid var(--line);
    }

    ul li:last-child .nav-link {
      border-bottom: none;
    }
  }
</style>

<script>
  // ---- Sticky shadow on scroll ----
  const header = document.getElementById('site-header');
  const onScroll = () =>
    header?.classList.toggle('scrolled', window.scrollY > 10);
  window.addEventListener('scroll', onScroll, { passive: true });

  // ---- Active nav link highlight ----
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const sections = document.querySelectorAll<HTMLElement>(
    'section[id], div[id]'
  );

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            link.classList.toggle(
              'active',
              link.getAttribute('href') === `#${entry.target.id}`
            );
          });
        }
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );
  sections.forEach((s) => observer.observe(s));

  // ---- Mobile menu toggle ----
  const btn = document.querySelector<HTMLButtonElement>('.toggle');
  const list = document.querySelector<HTMLElement>('nav');
  const closeMenu = () => {
    btn?.setAttribute('aria-expanded', 'false');
    list?.removeAttribute('data-open');
  };

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    list?.toggleAttribute('data-open', !open);
  });

  // Close on nav link click (mobile)
  list?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).classList.contains('nav-link')) closeMenu();
  });

  // ---- Theme toggle ----
  const themeBtn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  themeBtn?.addEventListener('click', () => {
    const current = root.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });
</script>

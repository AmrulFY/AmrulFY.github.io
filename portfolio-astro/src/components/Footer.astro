---
import { site } from '../data/site';
---

<footer aria-label="Site footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="brand-initials" aria-hidden="true">
        AF
      </span>
      <p class="footer-name">{site.name}</p>
      <p class="footer-tagline">
        Data Scientist · Machine Learning · Cryptography
      </p>
    </div>

    <nav aria-label="Footer navigation">
      <ul class="footer-nav">
        {site.nav.map((n) => (
          <li>
            <a href={n.href}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="social-links">
      <!-- GitHub -->
      <a
        href={site.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
        aria-label="GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12" />
        </svg>
      </a>
      <!-- LinkedIn -->
      <a
        href={site.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
        aria-label="LinkedIn"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
      </a>
      <!-- Instagram -->
      <a
        href={site.links.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
        aria-label="Instagram @simplemath_id"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
        </svg>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>
        &copy; {new Date().getFullYear()} {site.name}. Built with Astro.
      </p>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
  }

  .footer-inner {
    display: grid;
    gap: 2rem 3rem;
    padding-block: 3rem 2rem;
  }

  @media (min-width: 48rem) {
    .footer-inner {
      grid-template-columns: 1fr auto auto;
      align-items: start;
    }
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .brand-initials {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .footer-name {
    font-weight: 700;
    color: var(--ink);
    font-size: var(--fs-sm);
    max-width: none;
  }

  .footer-tagline {
    font-size: var(--fs-xs);
    color: var(--muted);
    max-width: none;
  }

  /* Nav */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0;
  }

  .footer-nav a {
    font-size: var(--fs-sm);
    color: var(--muted);
    font-weight: 500;
    transition: color var(--dur) var(--ease);
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  /* Social */
  .social-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    color: var(--muted);
    transition:
      color var(--dur) var(--ease),
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .social-icon:hover {
    color: var(--accent);
    background: var(--accent-glow);
    border-color: var(--line-hover);
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-block: 1rem;
  }

  .footer-bottom p {
    font-size: var(--fs-xs);
    color: var(--muted);
    max-width: none;
  }
</style>

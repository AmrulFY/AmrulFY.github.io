---
import { Picture } from 'astro:assets';
import portrait from '../assets/ft.png';
import { site } from '../data/site';
---

<section class="hero" id="top" aria-label="Introduction">
  <div class="hero-bg" aria-hidden="true">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>

  <div class="container hero-inner">
    <!-- Text column -->
    <div class="hero-text">
      <!-- Badge disembunyikan sementara (terikat kontrak) -->

      <h1 style="animation-delay: 80ms">
        <span class="name-line">Amrul Fadhil</span>
        <span class="name-accent">Yofan</span>
      </h1>

      <p class="role" style="animation-delay: 160ms">
        {site.role}
      </p>

      <p class="lead" style="animation-delay: 240ms">
        Turning raw data into decisions — from time-series forecasting and NLP
        models to mathematical cryptography research. UGM Mathematics graduate.
      </p>

      <div class="cta" style="animation-delay: 320ms">
        <a class="btn" href="#projects">
          View My Work
        </a>
        <a class="btn ghost" href="/cv.pdf" download>
          Download CV
        </a>
      </div>

      <!-- Social quick links -->
      <div class="social-row" style="animation-delay: 400ms">
        <a
          href={site.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="GitHub profile"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12" />
          </svg>
          GitHub
        </a>
        <a
          href={site.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="LinkedIn profile"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Photo column -->
    <div class="hero-photo">
      <div class="photo-wrap">
        <Picture
          src={portrait}
          alt="Portrait of Amrul Fadhil Yofan"
          widths={[260, 320, 480]}
          formats={['avif', 'webp']}
          sizes="(max-width: 56rem) 260px, 300px"
          loading="eager"
          fetchpriority="high"
        />
        <div class="photo-ring" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Hero section ---- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 14vw, 10rem) clamp(4rem, 10vw, 7rem);
    /* subtle dot grid */
    background-image: radial-gradient(circle, var(--grid) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  /* ---- Ambient glow blobs ---- */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.35;
  }

  .glow-1 {
    width: 55vw;
    height: 55vw;
    max-width: 600px;
    max-height: 600px;
    background: radial-gradient(circle, var(--accent), transparent 70%);
    top: -20%;
    right: -10%;
    animation: float 8s ease-in-out infinite;
  }

  .glow-2 {
    width: 40vw;
    height: 40vw;
    max-width: 400px;
    max-height: 400px;
    background: radial-gradient(circle, var(--accent-2), transparent 70%);
    bottom: -15%;
    left: -5%;
    animation: float 10s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-3%) scale(1.04);
    }
  }

  /* ---- Inner layout ---- */
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero-inner {
      grid-template-columns: 1fr auto;
    }
  }

  /* ---- Text ---- */
  .hero-text > * {
    opacity: 0;
    animation: fadeUp 0.55s var(--ease) both;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Available badge */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: none;
    background: var(--accent-glow);
    border: 1px solid var(--line-hover);
    color: var(--accent-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  /* Name */
  h1 {
    margin-bottom: 0.5rem;
    font-size: var(--fs-h1);
  }

  .name-line {
    display: block;
  }

  .name-accent {
    display: block;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Role */
  .role {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 1rem;
    max-width: none;
  }

  /* Lead */
  .lead {
    font-size: var(--fs-lg);
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 52ch;
    margin-bottom: 2rem;
  }

  /* CTA buttons */
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  /* Social links row */
  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    padding: 0.3rem 0.1rem;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .social-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* ---- Photo ---- */
  .hero-photo {
    display: flex;
    justify-content: center;
  }

  .photo-wrap {
    position: relative;
    width: 260px;
    height: 260px;
    flex-shrink: 0;
  }

  @media (min-width: 56rem) {
    .photo-wrap {
      width: 300px;
      height: 300px;
    }
  }

  .photo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 2px solid var(--line);
    position: relative;
    z-index: 1;
    animation: fadeIn 0.7s var(--ease) 0.4s both;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Animated ring border */
  .photo-ring {
    position: absolute;
    inset: -6px;
    border-radius: calc(var(--radius-lg) + 6px);
    background: conic-gradient(
      from 0deg,
      var(--accent) 0deg,
      var(--accent-2) 90deg,
      transparent 180deg,
      var(--accent) 360deg
    );
    opacity: 0.5;
    animation: spin-ring 6s linear infinite;
    z-index: 0;
  }

  @keyframes spin-ring {
    to {
      transform: rotate(360deg);
    }
  }
</style>

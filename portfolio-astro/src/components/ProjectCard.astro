---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { data } = Astro.props.project;

// Map tag to color class for variety
const tagColors: Record<string, string> = {
  Python: 'tag-py',
  TensorFlow: 'tag-tf',
  PyTorch: 'tag-pt',
  NLP: 'tag-nlp',
  CNN: 'tag-cnn',
  'Time Series': 'tag-ts',
  Deployment: 'tag-dep',
};
---

<article class="card card-glass">
  <!-- Top bar accent -->
  <div class="card-accent" aria-hidden="true"></div>

  <!-- Content -->
  <div class="card-body">
    <h3>{data.title}</h3>
    <p class="summary">{data.summary}</p>

    {data.metric && (
      <div class="metric-badge">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
          <polyline points="16 7 22 7 22 13" />
        </svg>
        {data.metric}
      </div>
    )}

    <!-- Tags -->
    <ul class="tags" aria-label="Technologies used">
      {data.tags.map((t) => (
        <li class={`tag ${tagColors[t] ?? ''}`}>{t}</li>
      ))}
    </ul>
  </div>

  <!-- Links footer -->
  <div class="card-footer">
    <a
      href={data.repo}
      target="_blank"
      rel="noopener noreferrer"
      class="card-link"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12" />
      </svg>
      View Code
    </a>
    {data.demo && (
      <a
        href={data.demo}
        target="_blank"
        rel="noopener noreferrer"
        class="card-link card-link-demo"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <polyline points="15 3 21 3 21 9" />
          <line x1="10" y1="14" x2="21" y2="3" />
        </svg>
        Live Demo
      </a>
    )}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    /* card-glass mixin applied */
    padding: 0;
  }

  /* Accent bar on top */
  .card-accent {
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--accent),
      var(--accent-2),
      transparent
    );
    flex-shrink: 0;
  }

  /* Body */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1.5rem 0;
    flex: 1;
  }

  h3 {
    font-size: var(--fs-h3);
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .summary {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: 1.65;
    flex: 1;
  }

  /* Metric badge */
  .metric-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #22c55e;
    font-size: var(--fs-xs);
    font-weight: 700;
    width: fit-content;
  }

  /* Tags */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin-top: 0.25rem;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: var(--fs-xs);
    font-weight: 600;
    background: var(--accent-glow);
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .tag-py {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.25);
    color: #60a5fa;
  }
  .tag-tf {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.25);
    color: #f87171;
  }
  .tag-pt {
    background: rgba(234, 88, 12, 0.1);
    border-color: rgba(234, 88, 12, 0.25);
    color: #fb923c;
  }
  .tag-nlp {
    background: rgba(168, 85, 247, 0.1);
    border-color: rgba(168, 85, 247, 0.25);
    color: #c084fc;
  }
  .tag-cnn {
    background: rgba(20, 184, 166, 0.1);
    border-color: rgba(20, 184, 166, 0.25);
    color: #2dd4bf;
  }
  .tag-ts {
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.25);
    color: #fbbf24;
  }
  .tag-dep {
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.25);
    color: #4ade80;
  }

  /* Card footer */
  .card-footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .card-link:hover {
    color: var(--accent);
  }
  .card-link-demo:hover {
    color: #22c55e;
  }
</style>
